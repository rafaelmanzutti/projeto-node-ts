{
  "name": "cadastro-clientes-node-ts",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "overrides": {
    "@hono/node-server": "1.19.13"
  },
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx watch ./src/index.ts",
    "start": "node ./dist/index.js",
    "build": "tsc --build tsconfig.build.json && tsup src --minify",
    "prettier": "prettier --write ./src/**/*.ts",
    "lint": "eslint ./src",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache --coverage --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache --watchAll --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache --coverage --runInBand"
  },
  "author": "Rafael Manzutti",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "prisma": "^7.8.0",
    "ts-jest": "^29.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
